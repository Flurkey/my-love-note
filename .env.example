# Optional: add these to enable shareable links (card data stored in Supabase).
# Create a project at https://supabase.com and run the SQL below, then copy your URL and anon key here.
# For local dev, copy this file to .env and fill in the values.
# For GitHub Pages, add VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY as repository secrets and pass them in the build step.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
